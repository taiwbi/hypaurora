# Native bash prompt with Powerline effects
#
# Layout:
#   [user] dir  branch  ❯ COMMAND
# When the terminal is narrower than 50 columns it splits into two lines.

# ---- helpers --------------------------------------------------------------

# Shorten the working directory: /home/mahdi/Documents/Projects/x -> ~/D/P/x
_prompt_pwd() {
    local path="${PWD/#$HOME/\~}" prefix=''
    [[ $path == /* ]] && prefix='/'
    path=${path#/}
    local IFS='/'
    local parts=($path)
    local n=${#parts[@]} out='' i p
    for (( i = 0; i < n; i++ )); do
        p=${parts[i]}
        if (( i == n - 1 )); then
            out+=$p
        elif [[ $p == .* ]]; then
            out+="${p:0:2}/"
        else
            out+="${p:0:1}/"
        fi
    done
    printf '%s%s' "$prefix" "$out"
}

# Emit the git segment. Silent if there is no git command or the current
# directory is not a repository.
# Returns exit code:
#   0: Clean git repository
#   1: Dirty git repository
#   2: Not a git repository
_prompt_git() {
    command -v git >/dev/null 2>&1 || return 2
    local branch
    branch=$(git symbolic-ref --short -q HEAD 2>/dev/null) \
        || branch=$(git rev-parse --short HEAD 2>/dev/null) \
        || return 2

    local info staged=0 modified=0 untracked=0 ahead=0 behind=0 line
    info=$(git status --porcelain --branch 2>/dev/null)
    while IFS= read -r line; do
        case $line in
            '## '*)
                [[ $line =~ ahead\ ([0-9]+) ]]  && ahead=${BASH_REMATCH[1]}
                [[ $line =~ behind\ ([0-9]+) ]] && behind=${BASH_REMATCH[1]}
                ;;
            '??'*) untracked=1 ;;
            '')    ;;
            *)
                [[ ${line:0:1} != ' ' && ${line:0:1} != '?' ]] && staged=1
                [[ ${line:1:1} != ' ' ]] && modified=1
                ;;
        esac
    done <<< "$info"

    local st=''
    (( ahead > 0 ))  && st+="⇡$ahead"
    (( behind > 0 )) && st+="⇣$behind"
    (( staged ))     && st+='+'
    (( modified ))   && st+='!'
    (( untracked ))  && st+='?'

    local out=" $branch"
    [[ -n $st ]] && out+=" $st"
    printf '%s' "$out"

    if (( staged || modified || untracked )); then
        return 1
    else
        return 0
    fi
}

# ---- prompt ---------------------------------------------------------------

_prompt_render() {
    local exit=$?
    local cols=${COLUMNS:-80}

    # Colors (Standard ANSI color codes to support terminal themes)
    local BG_USER_ROOT=41
    local FG_USER_ROOT=31

    local BG_USER_SSH=45
    local FG_USER_SSH=35

    local BG_DIR=44
    local FG_DIR_CODE=34
    local FG_DIR_TEXT=97

    local BG_GIT_CLEAN=42
    local FG_GIT_CLEAN_CODE=32
    local FG_GIT_CLEAN_TEXT=30

    local BG_GIT_DIRTY=43
    local FG_GIT_DIRTY_CODE=33
    local FG_GIT_DIRTY_TEXT=30

    # Username: only for root (red) or over SSH (user@host).
    local user_seg=''
    local user_bg=''
    local user_fg=''
    if (( EUID == 0 )); then
        user_seg=" \u "
        user_bg=$BG_USER_ROOT
        user_fg=$FG_USER_ROOT
    elif [[ -n $SSH_CONNECTION || -n $SSH_TTY || -n $SSH_CLIENT ]]; then
        user_seg=" \u@\h "
        user_bg=$BG_USER_SSH
        user_fg=$FG_USER_SSH
    fi

    local dir_seg=" $(_prompt_pwd) "
    local dir_bg=$BG_DIR

    local git_seg=''
    local git_bg=''
    local git_fg=''
    local git_fg_text=''
    local git_info
    git_info=$(_prompt_git)
    local git_status=$?
    if (( git_status == 0 )); then
        git_seg=" $git_info "
        git_bg=$BG_GIT_CLEAN
        git_fg=$FG_GIT_CLEAN_CODE
        git_fg_text=$FG_GIT_CLEAN_TEXT
    elif (( git_status == 1 )); then
        git_seg=" $git_info "
        git_bg=$BG_GIT_DIRTY
        git_fg=$FG_GIT_DIRTY_CODE
        git_fg_text=$FG_GIT_DIRTY_TEXT
    fi

    # Assemble line 1 with powerline transitions
    local line1=''
    if [[ -n $user_seg ]]; then
        # Segment 1: User
        line1+="\[\e[${user_bg};97m\]${user_seg}"
        # Transition: User -> Dir
        line1+="\[\e[${dir_bg};${user_fg}m\]\[\e[${FG_DIR_TEXT}m\]"
    else
        # Start directly with Dir
        line1+="\[\e[${dir_bg};${FG_DIR_TEXT}m\]"
    fi

    # Segment 2: Dir
    line1+="${dir_seg}"

    if [[ -n $git_seg ]]; then
        # Transition: Dir -> Git
        line1+="\[\e[${git_bg};${FG_DIR_CODE}m\]\[\e[${git_fg_text}m\]"
        # Segment 3: Git
        line1+="${git_seg}"
        # End Git -> Default
        line1+="\[\e[49;${git_fg}m\]\[\e[0m\]"
    else
        # End Dir -> Default
        line1+="\[\e[49;${FG_DIR_CODE}m\]\[\e[0m\]"
    fi

    # Prompt symbol: ❯ colored green on success, red on failure
    local symbol='❯'
    (( EUID == 0 )) && symbol='#'
    local prompt_color="\[\e[32m\]"
    (( exit != 0 )) && prompt_color="\[\e[31m\]"
    local prompt_char="${prompt_color}${symbol}\[\e[0m\]"

    # Separator: space (one line) or newline (narrow terminal).
    local sep=' '
    _prompt_last_height=1
    if (( cols < 50 )); then
        sep='\n'
        _prompt_last_height=2
    fi

    PS1="${line1}${sep}${prompt_char} "
}

# Transient prompt logic
_transient_pre() {
    _prompt_last_command=$READLINE_LINE
}

_prompt_debug_trap() {
    if [[ -n $_prompt_last_command ]]; then
        local exit=$?
        local symbol='❯'
        (( EUID == 0 )) && symbol='#'
        local prompt_color="\e[32m"
        (( exit != 0 )) && prompt_color="\e[31m"
        
        if (( _prompt_last_height == 2 )); then
            # Move up 2 lines, clear top line
            printf "\e[2A\r\e[2K" >&2
            # Move down 1 line, clear command line, print transient prompt + command
            printf "\e[1B\r\e[2K %b%s\e[0m %s\n" "${prompt_color}" "${symbol}" "${_prompt_last_command}" >&2
        else
            # Move up 1 line, clear line, print transient prompt + command, and move down
            printf "\e[1A\r\e[2K %b%s\e[0m %s\n" "${prompt_color}" "${symbol}" "${_prompt_last_command}" >&2
        fi
        
        _prompt_last_command=
    fi
}

shopt -s checkwinsize
shopt -u promptvars
PROMPT_COMMAND='_prompt_render'

if [[ $- == *i* ]]; then
    bind -x '"\e\C-e": _transient_pre'
    bind '"\e\C-j": accept-line'
    bind '"\C-m": "\e\C-e\e\C-j"'
    bind '"\C-j": "\e\C-e\e\C-j"'
    trap '_prompt_debug_trap' DEBUG
fi
