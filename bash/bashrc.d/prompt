# Native bash prompt
#
# Layout:
#   [user] dir branch $ COMMAND
# When the terminal is narrower than 50 columns it splits into two lines.

# ---- helpers --------------------------------------------------------------

# Strip characters that could trigger prompt expansion (command/parameter
# substitution, backslash escapes) if untrusted text (e.g. a malicious git
# branch name or directory name) ends up embedded in PS1.
_prompt_sanitize() {
    local s=${1//$'\\'/}
    s=${s//\$/}
    printf '%s' "${s//\`/}"
}

# Return the number of terminal cells occupied by a string. Readline wraps
# based on cells rather than bytes, so this is more accurate for non-ASCII
# command lines and prompt segments than Bash's ${#value}.
_prompt_display_width() {
    printf '%s' "$1" | wc -L
}

# Shorten the working directory: /home/mahdi/Documents/Projects/x -> ~/D/P/x
_prompt_pwd() {
    local path="${PWD/#$HOME/\~}" prefix=''
    [[ $path == /* ]] && prefix='/'
    path=${path#/}
    local IFS='/'
    local parts=($path)
    local n=${#parts[@]} out='' i p
    for (( i = 0; i < n; i++ )); do
        p=${parts[i]}
        if (( i == n - 1 )); then
            out+=$p
        elif [[ $p == .* ]]; then
            out+="${p:0:2}/"
        else
            out+="${p:0:1}/"
        fi
    done
    printf '%s%s' "$prefix" "$(_prompt_sanitize "$out")"
}

# Emit the git segment. Silent if there is no git command or the current
# directory is not a repository.
# Returns exit code:
#   0: Clean git repository
#   1: Dirty git repository
#   2: Not a git repository
_prompt_git() {
    command -v git >/dev/null 2>&1 || return 2
    local branch
    branch=$(git symbolic-ref --short -q HEAD 2>/dev/null) \
        || branch=$(git rev-parse --short HEAD 2>/dev/null) \
        || return 2
    branch=$(_prompt_sanitize "$branch")

    local info staged=0 modified=0 untracked=0 ahead=0 behind=0 line
    info=$(git status --porcelain --branch 2>/dev/null)
    while IFS= read -r line; do
        case $line in
            '## '*)
                [[ $line =~ ahead\ ([0-9]+) ]]  && ahead=${BASH_REMATCH[1]}
                [[ $line =~ behind\ ([0-9]+) ]] && behind=${BASH_REMATCH[1]}
                ;;
            '??'*) untracked=1 ;;
            '')    ;;
            *)
                [[ ${line:0:1} != ' ' && ${line:0:1} != '?' ]] && staged=1
                [[ ${line:1:1} != ' ' ]] && modified=1
                ;;
        esac
    done <<< "$info"

    local st=''
    (( ahead > 0 ))  && st+="⇡$ahead"
    (( behind > 0 )) && st+="⇣$behind"
    (( staged ))     && st+='+'
    (( modified ))   && st+='!'
    (( untracked ))  && st+='?'

    local out=" $branch"
    [[ -n $st ]] && out+=" $st"
    printf '%s' "$out"

    if (( staged || modified || untracked )); then
        return 1
    else
        return 0
    fi
}

# ---- prompt ---------------------------------------------------------------

_prompt_render() {
    local exit=$?
    local cols=${COLUMNS:-80}

    # Foreground colors (Standard ANSI color codes to support terminal themes)
    local FG_USER_ROOT='31'
    local FG_USER_SSH='35'
    local FG_DIR='34'
    local FG_GIT_CLEAN='32'
    local FG_GIT_DIRTY='33'

    local prompt_text='' prompt_visible=''

    # Segment 1: User (only for root or over SSH)
    if (( EUID == 0 )); then
        prompt_text+="\[\e[${FG_USER_ROOT}m\]\u\[\e[0m\] "
        prompt_visible+="${USER:-root} "
    elif [[ -n $SSH_CONNECTION || -n $SSH_TTY || -n $SSH_CLIENT ]]; then
        prompt_text+="\[\e[${FG_USER_SSH}m\]\u@\h\[\e[0m\] "
        prompt_visible+="${USER:-$(id -un)}@${HOSTNAME%%.*} "
    fi

    # Segment 2: Directory
    local prompt_pwd=$(_prompt_pwd)
    prompt_text+="\[\e[${FG_DIR}m\]${prompt_pwd}\[\e[0m\]"
    prompt_visible+="$prompt_pwd"

    # Segment 3: Git
    local git_info
    git_info=$(_prompt_git)
    local git_status=$?
    if (( git_status == 0 )); then
        prompt_text+=" \[\e[${FG_GIT_CLEAN}m\]${git_info}\[\e[0m\]"
        prompt_visible+=" ${git_info}"
    elif (( git_status == 1 )); then
        prompt_text+=" \[\e[${FG_GIT_DIRTY}m\]${git_info}\[\e[0m\]"
        prompt_visible+=" ${git_info}"
    fi

    # Prompt symbol: $ colored green on success, red on failure
    local symbol='$'
    (( EUID == 0 )) && symbol='#'
    local prompt_color="\[\e[32m\]"
    (( exit != 0 )) && prompt_color="\[\e[31m\]"
    local prompt_char="${prompt_color}${symbol}\[\e[0m\]"

    # Separator: space (one line) or newline (narrow terminal).
    local sep=' '
    _prompt_last_height=1
    if (( cols < 50 )); then
        sep='\n'
        _prompt_last_height=2
        # The command starts after the transient prompt's "$ " line.
        _prompt_last_line_width=2
    else
        # The command starts after: prompt text + separator + "$ " (or "# ").
        _prompt_last_line_width=$(( $(_prompt_display_width "$prompt_visible") + 3 ))
    fi

    PS1="${prompt_text}${sep}${prompt_char} "
}

# Transient prompt logic
_transient_pre() {
    if [[ -n $_prompt_last_command ]]; then
        _prompt_last_command+=$'\n'"$READLINE_LINE"
    else
        _prompt_last_command=$READLINE_LINE
    fi
}

_prompt_debug_trap() {
    local exit=$?

    # A continued command invokes the bind -x callback once per submitted
    # line. Do not mistake that callback for the command about to execute.
    [[ $BASH_COMMAND == _transient_pre ]] && return

    if [[ -n $_prompt_last_command ]]; then
        local symbol='$'
        (( EUID == 0 )) && symbol='#'
        local prompt_color="\e[32m"
        (( exit != 0 )) && prompt_color="\e[31m"

        # After Readline accepts the input, the cursor is one row below its
        # last line. Count display rows, not just newlines: a long command can
        # occupy multiple terminal rows without containing a newline.
        local cols=${COLUMNS:-80}
        (( cols > 0 )) || cols=80
        local command_rows=0 line line_width line_rows line_cells had_newline
        local first_line=1 remaining=$_prompt_last_command
        while :; do
            had_newline=0
            if [[ $remaining == *$'\n'* ]]; then
                line=${remaining%%$'\n'*}
                remaining=${remaining#*$'\n'}
                had_newline=1
            else
                line=$remaining
            fi

            line_cells=$(_prompt_display_width "$line")
            if (( first_line )); then
                line_width=$(( _prompt_last_line_width + line_cells ))
                first_line=0
            else
                # Bash's default PS2 is "> ".
                line_width=$(( 2 + line_cells ))
            fi
            line_rows=$(( (line_width + cols - 1) / cols ))
            (( line_rows > 0 )) || line_rows=1
            (( command_rows += line_rows ))

            (( had_newline )) || break
        done

        local prompt_height=${_prompt_last_height:-1}
        local cursor_up=$(( prompt_height + command_rows - 1 ))
        printf "\e[%dA\r" "$cursor_up" >&2

        if (( prompt_height == 2 )); then
            # Keep the transient prompt on the original command row.
            printf "\e[2K\e[1B\r" >&2
        fi

        # Clear all of the old command rows before redrawing the saved input.
        printf "\e[J%b%s\e[0m %s\n" "${prompt_color}" "${symbol}" "${_prompt_last_command}" >&2

        _prompt_last_command=
    fi
}

shopt -s checkwinsize
# promptvars stays enabled (bash default) so shell integrations like
# ghostty's can append a live ${ ...; } hook to PS0. The git branch and
# cwd segments are sanitized via _prompt_sanitize before hitting PS1, so
# this doesn't reopen the untrusted-branch-name injection vector.
PROMPT_COMMAND='_prompt_render'

if [[ $- == *i* ]]; then
    bind -x '"\e\C-e": _transient_pre'
    bind '"\e\C-j": accept-line'
    bind '"\C-m": "\e\C-e\e\C-j"'
    bind '"\C-j": "\e\C-e\e\C-j"'
    trap '_prompt_debug_trap' DEBUG
fi
