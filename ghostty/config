# --- Fonts ---
font-family = "Hack"
font-family = "Vazir Code Hack"
font-family = "Symbols Nerd Font Mono"

font-size = 13

font-style="Medium"
font-style-bold="Extrabold"

# --- Cell Dimensions ---
adjust-cell-height = 9

# --- Window ---
window-width = 115
window-height = 27
background-opacity = 1

window-padding-x = 10
window-padding-y = 10

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = dark:Vague, light:Atom One Light
