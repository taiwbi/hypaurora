# --- Fonts ---
font-family = "Geist Mono"
font-family = "Vazir Code Hack"
font-family = "Symbols Nerd Font Mono"
font-feature = "+ss05"
font-feature = "CLIK"
font-feature = "JSPT"
font-feature = "PHPX"

font-style = Medium
font-style-bold = ExtraBold

font-size = 12

# --- Cell Dimensions ---
adjust-cell-height = 6

# --- Window ---
window-width = 100
window-height = 27
background-opacity = 1

window-padding-x = 8
window-padding-y = 8

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = dark:Oxocarbon, light:Oxocarbon Light
