# --- Fonts ---
font-family = "Hack"
font-family = "Vazir Code Hack"
font-family = "Symbols Nerd Font Mono"
font-feature = "+ss01"

font-style = Medium
font-style-bold = ExtraBold

font-size = 12

# --- Cell Dimensions ---
adjust-cell-height = 10

# --- Window ---
window-width = 100
window-height = 27
background-opacity = 1

window-padding-x = 5
window-padding-y = 5

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = dark:min, light:Gruvbox Light
