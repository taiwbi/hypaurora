# --- Fonts ---
font-family = "Elephant"
font-family = "AzarMehrMonospaced"
font-family = "Symbols Nerd Font Mono"

font-size = 11

# --- Cell Dimensions ---
adjust-cell-height = 6

# --- Window ---
window-width = 110
window-height = 30
background-opacity = 1

window-padding-x = 8
window-padding-y = 8

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = dark:nordic, light:Neobones Light
