# --- Fonts ---
font-family = "Monaspace Neon"
font-family = "AzarMehrMonospaced"
font-family = "Symbols Nerd Font Mono"

font-size = 11
font-feature = ss01, ss02, ss03, ss06, ss07, ss09

# --- Cell Dimensions ---
adjust-cell-height = 8

# --- Window ---
window-width = 130
window-height = 30
background-opacity = 1

window-padding-x = 10
window-padding-y = 10

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = light:JetBrains Islands Light,dark:JetBrains Islands Dark
