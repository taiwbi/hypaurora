# --- Fonts ---
font-family = "Iosevka"
font-family = "Vazir Code Hack"
font-family = "Symbols Nerd Font Mono"

font-style = "Bold"
font-style-bold = "Heavy"

font-size = 12

# --- Font Fallbacks ---
font-family = "Vazir Code Hack"

# --- Cell Dimensions ---
adjust-cell-height = 6

# --- Window ---
window-width = 130
window-height = 30
background-opacity = 1

window-padding-x = 10
window-padding-y = 10

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = light:Kanagawa Lotus,dark:Kanagawa Dragon
