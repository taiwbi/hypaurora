# --- Fonts ---
font-family = "Mona Sans Mono"
font-family = "AzarMehrMonospaced"
font-family = "Symbols Nerd Font Mono"

font-size = 12

# --- Cell Dimensions ---
adjust-cell-height = 6

# --- Window ---
window-width = 130
window-height = 30
background-opacity = 1

window-padding-x = 10
window-padding-y = 10

# --- Mouse ---
mouse-hide-while-typing = true

# --- Theme ---
window-theme = ghostty
theme = light:JetBrains Islands Light,dark:JetBrains Islands Dark
