# JetBrains Islands Dark — Ghostty Theme
# Faithful port of the JetBrains IDE default Islands Dark color scheme (2025.3+)
# Place this file in: ~/.config/ghostty/themes/
# Then set in your Ghostty config: theme = JetBrains Islands Dark

background = #1E1F22
foreground = #BCBEC4

cursor-color          = #BCBEC4
selection-background  = #393B40
selection-foreground  = #BCBEC4

# ANSI 0–7  (normal colors)
# 0  black        → folded / selection bg
palette = 0=#393B40
# 1  red          → error (dimmer)
palette = 1=#CF514E
# 2  green        → string
palette = 2=#6AAB73
# 3  yellow       → tag / attribute
palette = 3=#D5B778
# 4  blue         → number / integer literal
palette = 4=#2AACB8
# 5  magenta      → constant
palette = 5=#C77DBB
# 6  cyan         → keyword
palette = 6=#CF8E6D
# 7  white        → comment
palette = 7=#7A7E85

# ANSI 8–15 (bright/intense colors)
# 8  bright black  → diff-delete / dark gray
palette = 8=#484A4A
# 9  bright red    → error (vivid)
palette = 9=#F75464
# 10 bright green  → todo / doc highlight
palette = 10=#8BB33D
# 11 bright yellow → warning
palette = 11=#F2C55C
# 12 bright blue   → function / method
palette = 12=#56A8F5
# 13 bright magenta → instruction / parameter
palette = 13=#CDA3E6
# 14 bright cyan   → type / class name
palette = 14=#CC7832
# 15 bright white  → comment reference / white
palette = 15=#A1A1A1
