# JetBrains Islands Light — Ghostty Theme
# Faithful port of the JetBrains IDE default Islands Light color scheme (2025.3+)
# Place this file in: ~/.config/ghostty/themes/
# Then set in your Ghostty config: theme = JetBrains Islands Light

background = #FFFFFF
foreground = #000000

cursor-color          = #000000
selection-background  = #E9F5E6
selection-foreground  = #000000

# ANSI 0–7  (normal colors)
# 0  black        → folded / selection bg
palette = 0=#E9F5E6
# 1  red          → error (dimmer)
palette = 1=#CF514E
# 2  green        → string
palette = 2=#067D17
# 3  yellow       → tag / attribute (blue in light JB theme)
palette = 3=#0033B3
# 4  blue         → number / integer literal
palette = 4=#1750EB
# 5  magenta      → constant
palette = 5=#871094
# 6  cyan         → keyword / type
palette = 6=#0033B3
# 7  white        → comment
palette = 7=#8C8C8C

# ANSI 8–15 (bright/intense colors)
# 8  bright black  → diff-delete / medium gray
palette = 8=#D6D6D6
# 9  bright red    → error (vivid)
palette = 9=#F75464
# 10 bright green  → todo / hyperlink
palette = 10=#008DDE
# 11 bright yellow → warning
palette = 11=#A66F00
# 12 bright blue   → function / method
palette = 12=#286D73
# 13 bright magenta → instruction / parameter
palette = 13=#CDA3E6
# 14 bright cyan   → type / struct name
palette = 14=#00627A
# 15 bright white  → comment reference / white
palette = 15=#A1A1A1
