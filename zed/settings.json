// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// != == === <= >= --> <-- ==> <==
{
  "cli_default_open_behavior": "existing_window",
  "auto_update": false,
  "auto_update_extensions": {},

  // UI and Buffer =============================================
  "buffer_font_family": "Hack",
  "buffer_font_weight": 500,
  "buffer_font_fallbacks": ["Vazir Code Hack"],
  "buffer_font_size": 17,
  "buffer_font_features": {},
  "buffer_line_height": "comfortable",

  "diff_view_style": "unified",

  "theme": {
    "mode": "system",
    "dark": "Min Dark (Solid)",
    "light": "Min Light (Solid)",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
      "comment.doc": {
        "font_style": "italic",
      },
    },
  },
  "icon_theme": {
    "mode": "system",
    "dark": "Zed (Default)",
    "light": "Zed (Default)",
  },
  "selection_highlight": false,
  "cursor_blink": true,

  "ui_font_family": "Hack",
  "ui_font_size": 16,

  "vertical_scroll_margin": 6.0,
  "colorize_brackets": false,
  "show_whitespaces": "trailing",
  "indent_guides": {
    "enabled": true,
  },
  "minimap": {
    "show": "never",
  },

  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },

  // Agent =====================================================
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-terra"
      },
      "type": "registry"
    },
  },
  "agent": {
    "dock": "right",

    // chat window
    "default_model": {
      "provider": "openrouter",
      "model": "anthropic/claude-haiku-4.5",
    },
    "default_profile": "minimal",

    // inline assistant
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "minimax/minimax-m3",
      "enable_thinking": false,
    },
    "inline_alternatives": [],

    // commit message
    "commit_message_model": {
      "provider": "openrouter",
      "model": "minimax/minimax-m3",
    },
    "commit_message_instructions": "Format:\n<type>(scope): #issue_number <description>\n\n<body>\n\n[optional footer]\n\n# Commit Types\n- feat (new feature)\n- fix (bug patch)\n- build (build system/dependencies)\n- chore (maintenance)\n- ci (CI configuration)\n- docs (documentation)\n- style (formatting)\n- refactor (structure)\n- perf (performance)\n- test (adding/fixing tests)\n\n# Component Rules\n1. Scope: Add brackets context showing where the change happened (e.g., auth, api, ui, db).\n2.Only write issue number if it's provided in the context\n3. Description: A short, imperative mood summary (add not added), max 70 characters.\n4. Body: A detailed bulleted list explaining exactly *what* changed, *why* it changed, and the motivation or impact. \n   - Must use a dash (-) for bullets.\n   - Must be written in the imperative, present tense.\n   - Separate from the description by one blank line.\n   - Wrap lines at roughly 70 characters.\n5. Footer (Optional): Use only for breaking changes using the format: BREAKING CHANGE: <description>",
  },
  "agent_ui_font_size": 16.0,
  // edit predictions
  "show_edit_predictions": true,
  "edit_predictions": {
    "open_ai_compatible_api": {
      "max_output_tokens": 128,
      "model": "qwen/qwen2.5-coder-7b-instruct",
      "api_url": "https://openrouter.ai/api/v1",
      "prompt_format": "qwen",
    },
    "mode": "eager",
    "provider": "zed",
  },

  // Terminal ==================================================
  "terminal": {
    "font_family": "Hack",
    "font_size": 14,
    "font_weight": 500,
    "font_fallbacks": ["Vazir Code Hack", "Symbols Nerd Font"],
    "line_height": "comfortable",
  },

  // Behaviour =================================================
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "use_smartcase_search": true,
  "auto_indent_on_paste": true,
  "autosave": "on_focus_change",
  "restore_on_startup": "launchpad",
  "tab_bar": {
    "show": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": true,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "gutter": {
    "line_numbers": true,
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },

  "auto_install_extensions": {
    // languages
    "php": true,
    "blade": true,
    "html": true,
    "scss": true,
    "dockerfile": true,
    "git-firefly": true,
    "blueprint": true,
    "fish": true,
    "toml": true,
    "lua": true,
    // icons and themes
    "min-theme": true,
  },

  // LSP and Language Server ===================================
  "languages": {
    "PHP": {
      "formatter": {
        "external": {
          "command": "bash",
          "arguments": [
            "-c",
            "cat > {buffer_path} && ./vendor/bin/pint --quiet {buffer_path} && cat {buffer_path}",
          ],
        },
      },
      "language_servers": ["!phpantom", "phptools", "!intelephense", "!phpactor", "..."],
    },
    "Blade": {
      "language_servers": ["!phpantom", "phptools", "tailwindcss-language-server", "!intelephense", "!phpactor", "..."],
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html",
        },
        "experimental": {
          "classRegex": [
            // php
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            // blade
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)",
          ],
        },
      },
    },
    "phptools": { "initialization_options": { "0": "" } },
  },
}
